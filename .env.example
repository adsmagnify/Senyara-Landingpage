# Microsoft 365 mailbox that sends the booking notices.
# The From address must be this mailbox. Authenticated SMTP has to be turned on for it.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=learn@senyaralearning.com
SMTP_PASS=
# Inbox that receives each new booking. Defaults to the sending mailbox.
SMTP_TO=learn@senyaralearning.com

# OneDrive workbook that tracks every lead. Sign in once with scripts/connect-excel.mjs.
# On the live site, also set MS_REFRESH_TOKEN from data/excel-token.json.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
EXCEL_FILE=SenyaraLearningLeads.xlsx
